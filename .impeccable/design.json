      "html": "<button class=\"ds-family\" type=\"button\" aria-pressed=\"true\" aria-label=\"Illustrative subsystem: one of four methods passed\"><span class=\"ds-family-name\">Example subsystem</span><span class=\"ds-family-count\">1 / 4</span><span class=\"ds-family-percent\">25.00%</span><span class=\"ds-family-track\"><span class=\"ds-family-pass\"></span></span></button>",
      "css": ".ds-family{font-family:\"Segoe UI\",system-ui,sans-serif;line-height:1.5;width:100%;display:grid;grid-template-columns:minmax(0,1fr) 106px 74px;gap:9px 12px;text-align:left;padding:13px 16px;background:transparent;color:var(--text,#e7eeef);border:1px solid transparent;border-bottom-color:var(--line,#33444e);border-radius:0;cursor:pointer;transition:background .15s ease}.ds-family:hover{background:var(--surface,#17232b)}.ds-family[aria-pressed=\"true\"]{background:var(--raised,#1d2d36);border-color:#516773;border-radius:7px}.ds-family:focus-visible{outline:2px solid var(--pass,#85e3bd);outline-offset:4px;}.ds-family-name{font-size:14px;font-weight:500}.ds-family-count,.ds-family-percent{font-size:12px;text-align:right;font-variant-numeric:tabular-nums}.ds-family-count{color:var(--muted,#b0c0c8)}.ds-family-percent{color:var(--pass,#85e3bd)}.ds-family-track{display:flex;grid-column:1/-1;height:5px;background:var(--pending,#455c6a);border-radius:2px;overflow:hidden}.ds-family-pass{width:25%;background:var(--pass,#85e3bd)}@media(prefers-reduced-motion:reduce){.ds-family{transition:none}}",
      "refersTo": "family-selected"
