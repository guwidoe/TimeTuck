  "narrative": {
    "northStar": "The Laboratory Progress Board",
    "overview": "TimeTuck presents measured progress through restrained dark surfaces, fine dividers, compact labels, and mint evidence marks. Its character comes from the data's geometry: segmented tracks and individual method squares make both completed and remaining work visible.\n\nThis document records the implemented dashboard, not an independently approved brand identity. The descriptive north star and palette names are documentation choices. The build uses self-hosted Barlow headings, system UI controls, and monospace identifiers; no photographic or generated image composition underlies the interface. Route-specific reading order and measurement caveats live in the dashboard surface brief.",
    "keyCharacteristics": [
      "Dark blue-gray surfaces with tonal separation.",
      "Compact, readable evidence with tabular numbers.",
      "Mint highlights paired with explicit result labels.",
      "Fine rectangular marks and gently rounded working panels."
    ],
    "rules": [
      {
        "name": "The Labeled Evidence Rule",
        "body": "Color supports explicit state names, counts, and accessible chart descriptions; it never replaces them.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Coverage counts, percentages, measured timings, and ratios use tabular numerals so comparisons remain aligned as reports change.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Distinguish working surfaces with fill and border before introducing elevation effects.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve textual names and counts alongside every status color.",
      "**Do** keep the selected subsystem visually distinct and keyboard reachable.",
      "**Do** use Barlow for headings, system UI for controls, and monospace for identifiers.",
      "**Do** preserve focus visibility, readable metadata, and the reduced-motion behavior.",
      "**Do** keep scope and freshness information beside measured results."
    ],
    "donts": [
      "**Don't** present pending marks as passed or hide excluded methods from the coverage view.",
      "**Don't** use dark pending or exclusion chart colors as small text; use their readable text treatments.",
      "**Don't** imply that a microbenchmark ratio measures whole-solver performance.",
      "**Don't** turn method squares into the sole way to inspect a result."
    ]
  }
}
